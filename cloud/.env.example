# Copy to cloud/.env and fill in. cloud/.env is gitignored — never commit real keys.
#
# Backblaze B2 application key (create one scoped to a single bucket at
# https://secure.backblaze.com/app_keys.htm). "keyID" -> B2_KEY_ID,
# "applicationKey" -> B2_APP_KEY (shown only once at creation).
B2_KEY_ID=000xxxxxxxxxxxx0000000001
B2_APP_KEY=K000xxxxxxxxxxxxxxxxxxxxxxxxxxxx
B2_BUCKET=mst-dac-adapter

# NOTE: your vast.ai API key does NOT go in this file. Register it once with the CLI:
#   vastai set api-key <YOUR_API_KEY>
# It is stored in ~/.config/vastai/vast_api_key and read automatically by all scripts.

# --- vast.ai provisioning (optional overrides; sensible defaults in provision.sh) ---
# A recent CUDA PyTorch image. torch/torchaudio come from here — do not reinstall.
VAST_IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime
# Root disk in GB. Need room for code + 2.8 GB latents + checkpoints (~10 GB total is plenty).
VAST_DISK=40
# Offer search query. Model is tiny; any single mid-range GPU is fine.
VAST_QUERY="reliability>0.98 num_gpus=1 gpu_name in [RTX_3090,RTX_4090] inet_down>200 disk_space>40 rentable=true"